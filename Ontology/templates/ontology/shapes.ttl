@prefix ex: <https://example.org/ontology-template/demo#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ItemShape a sh:NodeShape ;
    sh:targetClass ex:Item ;
    sh:property [ sh:path ex:identifier ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path ex:tag ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ] .
