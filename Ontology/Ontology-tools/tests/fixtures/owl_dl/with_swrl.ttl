@prefix ex: <urn:test:owl-dl:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .

<urn:test:owl-dl:with-swrl> a owl:Ontology .
ex:A a owl:Class .
ex:B a owl:Class .
ex:x a swrl:Variable .
ex:r a swrl:Imp ;
    swrl:body ( [ a swrl:ClassAtom ; swrl:classPredicate ex:A ; swrl:argument1 ex:x ] ) ;
    swrl:head ( [ a swrl:ClassAtom ; swrl:classPredicate ex:B ; swrl:argument1 ex:x ] ) .
