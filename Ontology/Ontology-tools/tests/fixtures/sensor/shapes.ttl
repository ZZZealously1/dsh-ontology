@prefix ex: <urn:test:sensor:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
ex:DeviceShape a sh:NodeShape ; sh:targetClass ex:Device ;
  sh:property [ sh:path ex:hasReading ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:Reading ] .
ex:ReadingShape a sh:NodeShape ; sh:targetClass ex:Reading ;
  sh:property [ sh:path ex:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] .
