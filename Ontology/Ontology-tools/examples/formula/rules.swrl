<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
 xmlns:swrl="http://www.w3.org/2003/11/swrl#"
 xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
 <swrl:Variable rdf:about="urn:formula-example:e"/>
 <swrl:Variable rdf:about="urn:formula-example:o"/>
 <swrl:Variable rdf:about="urn:formula-example:v"/>
 <swrl:Imp rdf:about="urn:formula-example:permitFromObservation">
  <swrl:body rdf:parseType="Collection">
   <swrl:ClassAtom>
    <swrl:classPredicate rdf:resource="urn:formula-example:UsableObservation"/>
    <swrl:argument1 rdf:resource="urn:formula-example:o"/>
   </swrl:ClassAtom>
   <swrl:IndividualPropertyAtom>
    <swrl:propertyPredicate rdf:resource="urn:formula-example:hasObservation"/>
    <swrl:argument1 rdf:resource="urn:formula-example:e"/>
    <swrl:argument2 rdf:resource="urn:formula-example:o"/>
   </swrl:IndividualPropertyAtom>
  </swrl:body>
  <swrl:head rdf:parseType="Collection">
   <swrl:IndividualPropertyAtom>
    <swrl:propertyPredicate rdf:resource="https://w3id.org/ontology-tools/formula#satisfiedCondition"/>
    <swrl:argument1 rdf:resource="urn:formula-example:e"/>
    <swrl:argument2 rdf:resource="urn:formula-example:usableObservation"/>
   </swrl:IndividualPropertyAtom>
  </swrl:head>
 </swrl:Imp>
 <swrl:Imp rdf:about="urn:formula-example:classifyComputedResult">
  <swrl:body rdf:parseType="Collection">
   <swrl:ClassAtom>
    <swrl:classPredicate rdf:resource="https://w3id.org/ontology-tools/formula#Evaluation"/>
    <swrl:argument1 rdf:resource="urn:formula-example:e"/>
   </swrl:ClassAtom>
   <swrl:DatavaluedPropertyAtom>
    <swrl:propertyPredicate rdf:resource="https://w3id.org/ontology-tools/formula#result"/>
    <swrl:argument1 rdf:resource="urn:formula-example:e"/>
    <swrl:argument2 rdf:resource="urn:formula-example:v"/>
   </swrl:DatavaluedPropertyAtom>
   <swrl:BuiltinAtom>
    <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThan"/>
    <swrl:arguments rdf:parseType="Resource">
     <rdf:first rdf:resource="urn:formula-example:v"/>
     <rdf:rest rdf:parseType="Resource">
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.00004</rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
     </rdf:rest>
    </swrl:arguments>
   </swrl:BuiltinAtom>
  </swrl:body>
  <swrl:head rdf:parseType="Collection">
   <swrl:ClassAtom>
    <swrl:classPredicate rdf:resource="urn:formula-example:AboveSyntheticReference"/>
    <swrl:argument1 rdf:resource="urn:formula-example:e"/>
   </swrl:ClassAtom>
  </swrl:head>
 </swrl:Imp>
</rdf:RDF>
