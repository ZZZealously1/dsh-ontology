@prefix dct: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/ontology-template/demo#> .
@prefix meta: <https://example.org/ontology-template/meta#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:dataset-invalid a meta:Dataset ;
    meta:mode "synthetic" .

ex:item-invalid a ex:Item ;
    ex:tag "demo"^^xsd:string .

[] a rdf:Statement ;
    dct:source ex:source-template ;
    rdf:object "demo"^^xsd:string ;
    rdf:predicate ex:tag ;
    rdf:subject ex:item-invalid ;
    meta:locator "合成案例 invalid 的 tag 字段；无外部来源" .

