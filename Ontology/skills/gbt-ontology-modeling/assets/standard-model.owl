    <rdfs:range rdf:resource="https://example.org/standard-reference#InformationUnit"/>
    <rdfs:comment xml:lang="zh">来源对象属性表第 15 项：表示标准的某个要素或结构层次包含了一个具体的条款</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#referencesExternalResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">引用外部资源</rdfs:label>
