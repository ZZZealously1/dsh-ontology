    <rdfs:domain rdf:resource="https://example.org/standard-reference#StandardEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="zh">源字段 languageVersion，源类型 xsd:string；枚举：中文版本、英文版本</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#UntitledClause">
