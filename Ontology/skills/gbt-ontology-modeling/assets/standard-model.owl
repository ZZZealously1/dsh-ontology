    <rdfs:label xml:lang="en">issuedBy</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/standard-reference#StandardEntity"/>
    <rdfs:range rdf:resource="https://example.org/standard-reference#Organization"/>
    <rdfs:comment xml:lang="zh">来源对象属性表第 6 项：表示标准由某机构正式发布</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#NormativeReferences">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">规范性引用文件</rdfs:label>
    <rdfs:label xml:lang="en">NormativeReferences</rdfs:label>
    <rdfs:comment xml:lang="zh">原目录归入资料性要素，正式条款未核验；此处不激活该继承。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#standardNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">文件编号</rdfs:label>
    <rdfs:label xml:lang="en">standardNumber</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/standard-reference#StandardEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="zh">源字段 standardNumber，源类型 xsd:string；符合GB/T 1.1规定的文件编号格式</rdfs:comment>
    <rdfs:comment xml:lang="zh">原示例备注：符合GB/T 1.1规定的文件编号格式；正式标准对应关系待核验。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference/model">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
