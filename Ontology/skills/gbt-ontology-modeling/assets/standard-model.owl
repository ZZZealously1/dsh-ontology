    <rdfs:label xml:lang="en">ApprovalAndReleaseStage</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/standard-reference#StandardizationProcess"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#issuedDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">发布日期</rdfs:label>
    <rdfs:label xml:lang="en">issuedDate</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/standard-reference#StandardEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="zh">源字段 issuedDate，源类型 xsd:date；标准的官方发布日期（YYYY-MM-DD）。本合成资产明确采用 ISO 日期字符串，不自动转换项目事实。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#Constraint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
