    <rdfs:label xml:lang="en">Standardization Process</rdfs:label>
    <rdfs:comment xml:lang="zh">描述一项标准从预备到废止的全生命周期</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#standardConstraintType">
