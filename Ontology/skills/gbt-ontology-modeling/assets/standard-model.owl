    <rdfs:range rdf:resource="https://example.org/standard-reference#ExternalResource"/>
    <rdfs:comment xml:lang="zh">来源对象属性表第 31 项：表示标准或条款引用了法规、专利、文献等外部资源</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#Clause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
