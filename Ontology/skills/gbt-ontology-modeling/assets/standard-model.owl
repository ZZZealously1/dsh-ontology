    <rdfs:label xml:lang="en">StructuralElement</rdfs:label>
    <rdfs:label xml:lang="en">Structural Element</rdfs:label>
    <rdfs:comment xml:lang="zh">标准文本的层级结构实体</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#Object">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">对象</rdfs:label>
    <rdfs:label xml:lang="en">Object</rdfs:label>
    <rdfs:comment xml:lang="zh">条款中涉及的实体对象</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#Implementer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">组织实施单位</rdfs:label>
    <rdfs:label xml:lang="en">Implementer</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/standard-reference#Organization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#Proposer">
