  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#DomainCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">领域类别</rdfs:label>
    <rdfs:label xml:lang="en">DomainCategory</rdfs:label>
    <rdfs:label xml:lang="en">Domain Category</rdfs:label>
    <rdfs:comment xml:lang="zh">按标准化领域划分的标准分类</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#isRelatedToPatent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">与专利有关</rdfs:label>
