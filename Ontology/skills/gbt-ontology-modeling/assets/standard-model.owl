    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="zh">源字段 constraintType，源类型 xsd:string；枚举：强制性、推荐性</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#Paragraph">
