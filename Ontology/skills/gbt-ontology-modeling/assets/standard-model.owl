    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">行动</rdfs:label>
    <rdfs:label xml:lang="en">ActionClass</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#cites">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
