    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="zh">源字段 creditCode，源类型 xsd:string；18位数字/字母组成的唯一标识符</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#SymbolsAndAbbreviations">
