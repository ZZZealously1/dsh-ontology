    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="zh">源字段 constraintType，源类型 xsd:string；枚举：强制、推荐、描述</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#Reviewer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">评审人</rdfs:label>
    <rdfs:label xml:lang="en">Reviewer</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/standard-reference#Individual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#Scope">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">范围</rdfs:label>
    <rdfs:label xml:lang="en">Scope</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/standard-reference#NormativeElement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#effectiveDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">实施日期</rdfs:label>
    <rdfs:label xml:lang="en">effectiveDate</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/standard-reference#StandardEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="zh">源字段 effectiveDate，源类型 xsd:date；标准开始实施的日期。本合成资产明确采用 ISO 日期字符串，不自动转换项目事实。</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#StandardEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">标准实体</rdfs:label>
    <rdfs:label xml:lang="en">StandardEntity</rdfs:label>
    <rdfs:label xml:lang="en">Standard Entity</rdfs:label>
    <rdfs:comment xml:lang="zh">标准化文件的核心根节点，包含标准元数据和技术要素的完整描述</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#NumberedListItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">有编号列项</rdfs:label>
    <rdfs:label xml:lang="en">NumberedListItem</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/standard-reference#ListItem"/>
  </rdf:Description>
