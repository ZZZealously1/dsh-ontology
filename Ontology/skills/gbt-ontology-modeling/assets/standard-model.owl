    <rdfs:subClassOf rdf:resource="https://example.org/standard-reference#StructuralElement"/>
    <rdfs:comment xml:lang="zh">用于描述逻辑划分文本的实体</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#phone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">联系电话</rdfs:label>
