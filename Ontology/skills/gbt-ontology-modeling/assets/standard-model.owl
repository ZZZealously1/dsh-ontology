    <rdfs:range rdf:resource="https://example.org/standard-reference#Patent"/>
    <rdfs:comment xml:lang="zh">来源对象属性表第 32 项：表示条款的技术内容与某项专利有关</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#uniqueIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">唯一标识符</rdfs:label>
    <rdfs:label xml:lang="en">uniqueIdentifier</rdfs:label>
