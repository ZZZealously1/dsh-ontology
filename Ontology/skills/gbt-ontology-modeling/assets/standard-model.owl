    <rdfs:range rdf:resource="https://example.org/standard-reference#Property"/>
    <rdfs:comment xml:lang="zh">来源对象属性表第 25 项：表示条款对某个对象的特性做出了规定</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/standard-reference#imposesConstraint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
